 {
  "id": "OBJ-01",
  "probe": "a",
  "title": "создать запись справочника, получить по номеру",
  "source": "own",
  "kind": "cli",
  "steps": [
   {
    "args": [
     "db",
     "create",
     "$CFG",
     "$DB"
    ]
   },
   {
    "args": [
     "catalog",
     "add",
     "$CFG",
     "$DB",
     "goods",
     "Код=K-1",
     "Наименование=Кабель",
     "ЕдиницаИзмерения=м",
     "Используется=true",
     "МинимальныйОстаток=10.500"
    ],
    "contains": [
     "1"
    ]
   },
   {
    "args": [
     "catalog",
     "get",
     "$CFG",
     "$DB",
     "goods",
     "1"
    ],
    "contains": [
     "K-1",
     "Кабель",
     "10.500"
    ]
   }
  ]
 },
 {
  "id": "REG-02",
